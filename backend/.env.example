# Supabase -> Connect -> Session pooler URI, with postgresql:// changed to postgresql+psycopg2://
# URL-encode special characters in the password (@ becomes %40)
DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# openai or gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# gemini: gemini-2.5-flash
LLM_MODEL=gpt-4o-mini
# gemini: gemini-embedding-001
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=768

RAG_MIN_SCORE=0.35
RAG_HIGH_SCORE=0.55
CORS_ORIGINS=http://localhost:5173
POLICY_DIR=policies
UPLOAD_DIR=uploads
