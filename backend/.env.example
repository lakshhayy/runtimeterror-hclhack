# Supabase -> Connect -> Session pooler URI, with postgresql:// changed to postgresql+psycopg2://
# URL-encode special characters in the password (@ becomes %40)
DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# openai, gemini or groq
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# gemini: gemini-2.5-flash
LLM_MODEL=gpt-4o-mini
# groq: llama-3.3-70b-versatile
# Embeddings: openai, gemini or local (fastembed, free; use with groq). Empty = same as LLM_PROVIDER
EMBED_PROVIDER=
# gemini: gemini-embedding-001 | local: BAAI/bge-small-en-v1.5 with EMBED_DIM=384
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=768

RAG_MIN_SCORE=0.35
RAG_HIGH_SCORE=0.55
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POLICY_DIR=policies
UPLOAD_DIR=uploads

# Document storage: "local" (UPLOAD_DIR) or "supabase" (private bucket; required when deployed,
# because Render/Railway disks are wiped on redeploy). Service key = Supabase secret key (server only!)
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=loan-documents
